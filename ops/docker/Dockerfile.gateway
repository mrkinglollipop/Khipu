# Khipu gateway — MCP over HTTP for cloud harnesses (Grok Bot / Cursor cloud).
# Runs next to Postgres; a reverse proxy (Caddy) terminates TLS in front of it.
# Build context = repo root:  docker build -f ops/docker/Dockerfile.gateway -t khipu/gateway .
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 10001 khipu
WORKDIR /app
COPY packages/cli/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY packages/cli /app/packages/cli
ENV PYTHONPATH=/app/packages/cli \
    KHIPU_CAPTURE_MODE=hub \
    KHIPU_HUB_FILE_MIRROR=0 \
    KHIPU_GATEWAY_BIND=127.0.0.1:8787 \
    HOME=/home/khipu
USER khipu
CMD ["python", "-m", "khipu.gateway"]
