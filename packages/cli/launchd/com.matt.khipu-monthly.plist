<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.matt.khipu-monthly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3.11</string>
		<string>-m</string>
		<string>khipu</string>
		<string>monthly</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KHIPU_ROOT</key>
		<string>/Volumes/Cloud Storage/Code/Khipu</string>
		<key>PYTHONPATH</key>
		<string>/Volumes/Cloud Storage/Code/Khipu/packages/cli:/Volumes/Cloud Storage/Code/Khipu/.python_libs</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Volumes/Cloud Storage/Code/Khipu</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Day</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/matthewschwartz/Library/Logs/frozen-threshold/khipu-monthly.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/matthewschwartz/Library/Logs/frozen-threshold/khipu-monthly.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
