{
  "jobs_dir": "/runner/project-a/jobs-CANARY",
  "worktrees_dir": "/work/project-a",
  "repo_checkout": "/work/project-a/main",
  "state_dir": "/runner/project-a/state",
  "events_log": "/runner/project-a/events.log",
  "stop_file": "/runner/project-a/STOP",
  "rules_file": "/runner/project-a/RULES.md",
  "build_tail_file": "/runner/project-a/build-tail.txt",
  "templates_dir": "/runner/project-a/templates",
  "review_tail": "CANARY-review-tail: you are the independent reviewer from a different model family",
  "lanes": {
    "second": {"cap": 8, "kind": "claude", "model": "opus", "done_suffixes": ["CANARY-done"],
               "launch": ["bash", "/runner/project-a/launch-claude.sh", "{name}", "second", "opus", "{worktree}"]},
    "main": {"cap": 4, "kind": "claude", "model": "opus", "done_suffixes": ["DONE"],
             "launch": ["bash", "/runner/project-a/launch-claude.sh", "{name}", "main", "opus", "{worktree}"]},
    "codex": {"cap": 0, "kind": "codex", "model": "gpt-6.1-sol", "done_suffixes": ["DONE"],
              "launch": ["bash", "/runner/project-a/launch-codex.sh", "{name}", "gpt-6.1-sol", "{effort}",
                         "{worktree}", "8", "240"]},
    "grok": {"cap": 0, "kind": "grok", "model": "grok-4.7", "done_suffixes": ["DONE"],
             "launch": ["bash", "/runner/project-a/launch-grok.sh", "{name}", "{effort}", "{worktree}"],
             "last_md_is_transcript": true},
    "muse": {"cap": 0, "kind": "muse", "model": "muse-1.0", "done_suffixes": ["DONE"],
             "launch": ["bash", "/runner/project-a/launch-muse.sh", "{name}", "{effort}", "{worktree}"],
             "last_md_is_transcript": false},
    "grokcheck": {"cap": 0, "kind": "grokcheck", "model": "grok-4.7", "done_suffixes": ["DONE"],
                  "launch": ["bash", "/runner/project-a/launch-grokcheck.sh", "{name}", "{effort}", "{worktree}"],
                  "confirm_lane": "second"}
  },
  "defaults": {"check_lane": "main", "fix_lanes": ["second", "main"], "max_checks": 3, "effort": "high"},
  "guards": {"max_load1": 75, "max_swap_used_mb": 24000, "max_launches_per_hour": 60, "max_job_minutes": 360,
             "max_limit_bounces": 24, "note": "CANARY-guard"},
  "git": true,
  "saved_caps_CANARY": {"second": 10, "main": 1}
}
