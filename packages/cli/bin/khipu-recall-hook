#!/bin/sh
# khipu-recall-hook — SessionStart recall push. Default (Claude Code / Codex):
# prints hookSpecificOutput.additionalContext. With argv --cursor: prints
# top-level additional_context (Cursor's sessionStart inject field). Never fails
# a session: any error → {}.
# Aegis's runner env means Aegis is calling, and Aegis gets no recall rule by
# ANY route: its SessionStart is an Observe gate that discards stdout, so there
# is nothing to inject into (see khipu/recall_rule.py). Refuse on GROK runner
# vars AND on the pack's KHIPU_HARNESS=aegis mark (audit 2026-08-18).
if [ -n "${GROK_HOOK_NAME:-}${GROK_HOOK_EVENT:-}" ] || [ "${KHIPU_HARNESS:-}" = "aegis" ]; then
  cat >/dev/null 2>&1
  echo '{}'
  exit 0
fi
# Resolve the repo from THIS script's own location (following the shim symlink)
# rather than a hardcoded path: the pack is installed by symlink from wherever the
# repo lives, and a hook process does not inherit an interactive shell's exports,
# so a second machine with the repo somewhere else got a dead ROOT and a silent
# no-op. KHIPU_ROOT still wins when set.
SELF="$0"
HOPS=0
while [ -L "$SELF" ] && [ "$HOPS" -lt 40 ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
  HOPS=$((HOPS + 1))
done
SELF_DIR=$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)
ROOT="${KHIPU_ROOT:-$(cd "$SELF_DIR/../../.." 2>/dev/null && pwd)}"
PYTHONPATH="$ROOT/packages/cli:$ROOT/.python_libs${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
# The log dir must exist before any `2>>` redirect below, or sh fails the
# redirect and the hook silently does nothing (fresh machine, first run).
mkdir -p "${HOME}/Library/Logs/khipu" 2>/dev/null
# Bytecode cache goes OUTSIDE any signed .app bundle — see khipu.paths.pycache_dir.
# Running the bundled Python's __pycache__ writes inside Contents/Resources/khipu
# broke the code signature and made Gatekeeper report "Khipu is damaged" (0.3.15,
# withdrawn). mkdir failure is fail-open: PYTHONPYCACHEPREFIX to a missing dir
# just disables caching, never blocks the hook.
PYTHONPYCACHEPREFIX="${HOME}/Library/Caches/Khipu/pycache"
mkdir -p "$PYTHONPYCACHEPREFIX" 2>/dev/null
export PYTHONPYCACHEPREFIX
PY="${KHIPU_PYTHON:-/opt/homebrew/bin/python3.11}"
[ -x "$PY" ] || PY="python3"
SHAPE=claude
for a in "$@"; do
  case "$a" in --cursor) SHAPE=cursor ;; esac
done
"$PY" -c "from khipu.recall_rule import session_start_main; session_start_main(shape='$SHAPE')" 2>/dev/null || echo '{}'
exit 0
