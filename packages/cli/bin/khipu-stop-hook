#!/bin/sh
# khipu-stop-hook — Khipu's capture-side hook, installed ALONGSIDE the legacy
# capture hooks in Claude Code, Cursor and Codex (Stop / PreCompact /
# SessionEnd). Never in Aegis: Aegis sandboxes its hooks, and this hook's jobs
# need paths that sandbox denies (the legacy Memory tree, Postgres through a
# TLS root cert it cannot read). Aegis gets khipu-aegis-capture instead, which
# only queues; this hook drains that queue.
#
# Four jobs, in order, each fail-open so nothing here can ever block a session:
#
#   1. NATIVE CAPTURE (khipu.session_capture). Reads this session's transcript
#      from the harness's own hook payload, applies the fixed cadence (every 5
#      user turns / 20 min on Stop; always on PreCompact + SessionEnd) and
#      queues an extraction job. This is what replaced the legacy MODEL-driven
#      capture on 2026-08-17: the model was nudged 377 times in one session and
#      never captured once, so only the compaction safety net ever fired.
#      Deterministic now; nothing for the model to forget.
#   2. Drain the shared queue (this session's job and any other harness's,
#      Aegis included): model extraction, then khipu capture (PG first, file
#      mirror, embed). Capture lands in the same Stop that decided it was due.
#   3. Tail-sync the legacy episodes file into PG (identity upsert; cheap) and
#      replay the outbox — the parts that were here before.
#   3b. F1: mtime-gated khipu.notes.reconcile(changed_only=True) — a note
#      edited this session becomes a topic in this same Stop rather than
#      waiting for the nightly. Costs one stat() per known note file and
#      opens no DB connection at all when nothing changed.
#   4. Bounded embed catch-up for rows the mirror leg (and 3b's reconcile)
#      inserted — episodes, open commitments, AND (F2) topics with no
#      vector yet, so a just-reconciled note is vector-searchable this
#      same Stop too.
#
# Every native-capture run leaves a per-harness heartbeat under
# ~/.grok/khipu/dispatch/; `khipu doctor` and `khipu integrations verify` read
# it, so a hook that runs but records nothing turns something RED instead of
# staying quietly green.
#
# Aegis's runner env means Aegis is calling, and this hook must never run there
# — by ANY route. It used to make an exception for KHIPU_HARNESS=aegis, copied
# from khipu-aegis-capture where that exception is correct; here it contradicted
# the rule above, and measurably so: with the mark set, this script ran and
# wrote ~/Library/Logs/khipu/stop-hook.log, one of the paths the sandbox denies
# (audit 2026-08-18). Aegis capture goes through khipu-aegis-capture, and its
# queue is drained by another harness's Stop or by `khipu sessions drain`.
# maintainer, 2026-08-17: "I don't want Khipu running in Aegis through anything Claude."
if [ -n "${GROK_HOOK_NAME:-}${GROK_HOOK_EVENT:-}" ]; then
  cat >/dev/null 2>&1
  exit 0
fi
# Resolve the repo from THIS script's own location (following the shim symlink)
# rather than a hardcoded path: the pack is installed by symlink from wherever the
# repo lives, and a hook process does not inherit an interactive shell's exports,
# so a second machine with the repo somewhere else got a dead ROOT and a silent
# no-op. KHIPU_ROOT still wins when set.
SELF="$0"
HOPS=0
while [ -L "$SELF" ] && [ "$HOPS" -lt 40 ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
  HOPS=$((HOPS + 1))
done
SELF_DIR=$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)
ROOT="${KHIPU_ROOT:-$(cd "$SELF_DIR/../../.." 2>/dev/null && pwd)}"
# Legacy memory tree: env, else the Hub config file (khipu config --set
# memory_root ...). Empty when unconfigured; the Python below treats that as
# "no file wiki on this machine".
MEM="${KHIPU_MEMORY_ROOT:-}"
PYTHONPATH="$ROOT/packages/cli:$ROOT/.python_libs${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
# The log dir must exist before the `2>>` redirect below, or sh fails the
# redirect and the hook silently does nothing (fresh machine, first run).
# The promotion gate's isolated run (KHIPU_ISOLATED_DIR) logs inside it.
LOG_DIR="${HOME}/Library/Logs/khipu"
[ -n "${KHIPU_ISOLATED_DIR:-}" ] && LOG_DIR="${KHIPU_ISOLATED_DIR}/logs"
mkdir -p "$LOG_DIR" 2>/dev/null
# Bytecode cache goes OUTSIDE any signed .app bundle — see khipu.paths.pycache_dir.
# Running the bundled Python's __pycache__ writes inside Contents/Resources/khipu
# broke the code signature and made Gatekeeper report "Khipu is damaged" (0.3.15,
# withdrawn). mkdir failure is fail-open: PYTHONPYCACHEPREFIX to a missing dir
# just disables caching, never blocks the hook.
# A caller's own prefix is kept unless it points inside an .app bundle.
case "${PYTHONPYCACHEPREFIX:-}" in
  ""|*.app|*.app/*) PYTHONPYCACHEPREFIX="${HOME}/Library/Caches/Khipu/pycache" ;;
esac
mkdir -p "$PYTHONPYCACHEPREFIX" 2>/dev/null
export PYTHONPYCACHEPREFIX
PY="${KHIPU_PYTHON:-/opt/homebrew/bin/python3.11}"
[ -x "$PY" ] || PY="python3"
STDIN_JSON=$(cat 2>/dev/null)
export KHIPU_HOOK_STDIN="$STDIN_JSON"
# Queue-only mode leaves delivery to the next draining Stop or scheduled job.
"$PY" - "$MEM" "${KHIPU_HARNESS:-}" <<'PY' 2>>"$LOG_DIR/stop-hook.log" || true
import json
import os
import signal
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
QUEUE_ONLY = os.environ.get("KHIPU_CAPTURE_QUEUE_ONLY") == "1"
_T0 = time.monotonic()
tag = f" harness={sys.argv[2]}" if len(sys.argv) > 2 and sys.argv[2] else ""
_default_budget = 3.0 if len(sys.argv) > 2 and sys.argv[2] == "codex" else 20.0
try:
    _enqueue_budget = min(_default_budget, max(0.05, float(
        os.environ.get("KHIPU_CAPTURE_ENQUEUE_TIMEOUT_S") or _default_budget
    )))
except ValueError:
    _enqueue_budget = _default_budget


class _EnqueueDeadline(BaseException):
    pass


def _deadline(_signum, _frame):
    # BaseException deliberately bypasses hook_main's fail-open Exception
    # handler, so its heartbeat cleanup cannot extend the whole-phase budget.
    raise _EnqueueDeadline(f"capture enqueue exceeded {_enqueue_budget:g}s")
# Every line this hook writes is stamped (ISO-8601 UTC) and carries the session
# id. Without both, a quiet session in stop-hook.log could not be attributed to
# a run at all — you could not tell "the hook never fired for session X" from
# "it fired and decided not-due" (audit 2026-09-04).
def _stamp():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
try:
    SID = str((json.loads(os.environ.get("KHIPU_HOOK_STDIN") or "{}") or {}).get("session_id")
              or (json.loads(os.environ.get("KHIPU_HOOK_STDIN") or "{}") or {}).get("sessionId")
              or "")
except Exception:  # noqa: BLE001 — a malformed payload must not break logging
    SID = ""
def _say(msg):
    print(f"{_stamp()} [khipu-stop-hook] session={SID or '?'}{tag} {msg}", file=sys.stderr)
def _queued(q):
    # A large window is queued as several jobs, so this is a list as often as a
    # name. Concatenating the list raised after the jobs were already queued and
    # logged a capture that had happened as "capture skipped" (2026-09-29 on).
    if not q:
        return ""
    return " queued=" + (",".join(str(x) for x in q) if isinstance(q, (list, tuple)) else str(q))
try:
    # 1. Native capture for THIS session (harness inferred from the payload
    #    unless the pack pinned KHIPU_HARNESS). Never raises; always heartbeats.
    _previous_alarm = signal.signal(signal.SIGALRM, _deadline)
    signal.setitimer(signal.ITIMER_REAL, _enqueue_budget, 0.01)
    try:
        from khipu.session_capture import hook_main
        r = hook_main(os.environ.get("KHIPU_HOOK_STDIN", ""), sys.argv[2] or None)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, _previous_alarm)
    if r.get("skipped"):
        # T3's thread-title helper session: nothing captured, nothing logged,
        # nothing drained (the next real session's Stop does that).
        sys.exit(0)
    SID = str(r.get("session_id") or SID or "")
    _say(f"capture {r.get('harness')} {r.get('event')} due={r.get('due')} "
         f"{r.get('reason', '')}{_queued(r.get('queued'))}"
         f"{' ERROR ' + r['error'] if r.get('error') else ''}")
except _EnqueueDeadline as e:
    _say(f"capture skipped: {type(e).__name__}: {e}")
except Exception as e:  # noqa: BLE001 — fail-open, always
    _say(f"capture skipped: {type(e).__name__}: {e}")
if QUEUE_ONLY:
    sys.exit(0)
# 2. Everything after the enqueue runs in a detached process: draining the
#    shared queue (one model call per job), the legacy mirror, the outbox, the
#    notes reconcile and the embed catch-up. Inline, the drain alone held a
#    turn's end for a median 10 s and was killed at the harness's hook timeout
#    (2026-10-13). KHIPU_HOOK_INLINE=1 restores the inline behaviour.
try:
    from khipu import hook_background
    if os.environ.get("KHIPU_HOOK_INLINE") == "1":
        hook_background.run(sys.argv[1], sys.argv[2], SID)
    else:
        try:
            _pid = hook_background.spawn(sys.argv[1], sys.argv[2], SID)
            _say(f"background pid={_pid} hook_ms={round((time.monotonic() - _T0) * 1000)}")
        except Exception as e:  # noqa: BLE001 — a sandbox that refuses the spawn still drains
            _say(f"background spawn failed ({type(e).__name__}: {e}); running inline")
            hook_background.run(sys.argv[1], sys.argv[2], SID)
except Exception as e:  # noqa: BLE001 — fail-open, always
    _say(f"background skipped: {type(e).__name__}: {e}")
PY
exit 0
