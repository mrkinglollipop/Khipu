#!/bin/sh
# khipu-prompt-recall — UserPromptSubmit recall push (Phase 1, R1). Reads the
# harness's prompt-submit payload on stdin (prompt/cwd/session_id) and prints
# hookSpecificOutput.additionalContext with the top matching prior work, or
# {} when nothing qualifies. Never fails a turn: any error -> {}.
# Aegis's runner env means Aegis is calling, and Aegis gets no per-prompt
# push by ANY route: its UserPromptSubmit is an Observe gate that discards
# stdout, same as its SessionStart (see khipu/recall_rule.py). A compat import
# (GROK runner vars without the pack's KHIPU_HARNESS=aegis mark) runs nothing
# at all, same guard as khipu-recall-hook. The pack's own entry only records
# the owner's turn (below) and then prints {}.
if [ -n "${GROK_HOOK_NAME:-}${GROK_HOOK_EVENT:-}" ] && [ "${KHIPU_HARNESS:-}" != "aegis" ]; then
  cat >/dev/null 2>&1
  echo '{}'
  exit 0
fi
# Resolve the repo from THIS script's own location (following the shim symlink)
# rather than a hardcoded path — see khipu-recall-hook for why.
SELF="$0"
HOPS=0
while [ -L "$SELF" ] && [ "$HOPS" -lt 40 ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
  HOPS=$((HOPS + 1))
done
SELF_DIR=$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)
ROOT="${KHIPU_ROOT:-$(cd "$SELF_DIR/../../.." 2>/dev/null && pwd)}"
PY="${KHIPU_PYTHON:-/opt/homebrew/bin/python3.11}"
if [ -x "$SELF_DIR/../python/bin/python3.11" ]; then
  ROOT="${KHIPU_ROOT:-$(cd "$SELF_DIR/.." 2>/dev/null && pwd)}"
  PY="${KHIPU_PYTHON:-$ROOT/python/bin/python3.11}"
fi
if [ -x "$ROOT/python/bin/python3.11" ]; then
  PY="${KHIPU_PYTHON:-$ROOT/python/bin/python3.11}"
fi
[ -x "$PY" ] || PY="python3"
# The payload names the harness (khipu/hook_shape.py). An older install's --cursor
# is only a hint, used when the payload names no Cursor or Antigravity.
SHAPE=claude
HINT=""
for a in "$@"; do
  case "$a" in --cursor) SHAPE=cursor; HINT="--cursor" ;; esac
done
# stdin can be read once, and every path below needs the payload.
PAYLOAD=$(cat)
# Antigravity's PreInvocation fires before every model call and carries no
# prompt: the owner-turn script reads the newest USER_INPUT from the
# transcript and lets only the first call of each user turn through (it prints
# nothing for any other payload, "{}" for a turn already handled, and the
# payload with its prompt filled in for a new one).
case "$PAYLOAD" in
  *'"conversationId"'*)
    if [ -f "$SELF_DIR/khipu-owner-turn.py" ]; then
      TURN=$(printf '%s' "$PAYLOAD" | "$PY" -S -E -B "$SELF_DIR/khipu-owner-turn.py" --antigravity-turn 2>/dev/null)
      case "$TURN" in
        "") ;;
        "{}") echo '{}'; exit 0 ;;
        *) PAYLOAD="$TURN" ;;
      esac
    fi
    ;;
esac
# Owner direction: record that the owner typed, first, on every path
# (khipu.owner_turns). The recorder is stdlib-only, prints nothing and never
# fails.
if [ -f "$SELF_DIR/khipu-owner-turn.py" ]; then
  printf '%s' "$PAYLOAD" | "$PY" -S -E -B "$SELF_DIR/khipu-owner-turn.py" >/dev/null 2>&1
fi
if [ "${KHIPU_HARNESS:-}" = "aegis" ]; then
  echo '{}'
  exit 0
fi
# The warm recall service (khipu recall serve) answers in a few milliseconds; the
# client is stdlib-only. Exit 3 selects cold fallback; after a connected
# failure it also supplies the remaining absolute deadline. Exit 4 means
# the budget is spent. KHIPU_RECALL_DAEMON=0 skips it.
if [ "${KHIPU_RECALL_DAEMON:-1}" != "0" ] && [ -f "$SELF_DIR/khipu-recall-client.py" ]; then
  OUT=$(printf '%s' "$PAYLOAD" | "$PY" -S -E -B "$SELF_DIR/khipu-recall-client.py" "$SHAPE" 2>/dev/null)
  STATUS=$?
  if [ "$STATUS" -eq 0 ] || [ "$STATUS" -eq 4 ]; then
    [ -n "$OUT" ] || OUT='{}'
    printf '%s\n' "$OUT"
    exit 0
  fi
  if [ "$STATUS" -eq 3 ] && [ -n "$OUT" ]; then
    KHIPU_RECALL_DEADLINE="$OUT"
    export KHIPU_RECALL_DEADLINE
  fi
fi
PYTHONPATH="$ROOT/packages/cli:$ROOT/.python_libs${PYTHONPATH:+:$PYTHONPATH}"
if [ -d "$ROOT/lib" ] && [ -x "$ROOT/python/bin/python3.11" ]; then
  PYTHONPATH="$ROOT/packages/cli:$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
fi
export PYTHONPATH
[ -n "${KHIPU_ISOLATED_DIR:-}" ] || mkdir -p "${HOME}/Library/Logs/khipu" 2>/dev/null
# Bytecode cache goes OUTSIDE any signed .app bundle — see khipu.paths.pycache_dir.
PYTHONPYCACHEPREFIX="${HOME}/Library/Caches/Khipu/pycache"
mkdir -p "$PYTHONPYCACHEPREFIX" 2>/dev/null
export PYTHONPYCACHEPREFIX
printf '%s' "$PAYLOAD" | "$PY" -c "from khipu.recall_prompt import prompt_recall_main; prompt_recall_main(shape=None)" $HINT 2>/dev/null || echo '{}'
exit 0
