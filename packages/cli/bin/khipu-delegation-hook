#!/bin/sh
# khipu-delegation-hook — the routing push at the moment of delegation
# (routing truth, phase 6). PreToolUse: for a delegation call only, prints
# hookSpecificOutput.additionalContext with what changed in the routing
# record since the conversation last heard (the per-prompt push's read,
# budget and seen marker). SubagentStart: the full summary for the subagent.
# Never denies or changes a call, and never fails one: any error -> {}.
# Aegis's runner env means Aegis is calling, and Aegis gets no push by ANY
# route. Refuse on GROK runner vars AND on the pack's KHIPU_HARNESS=aegis
# mark, same guard as khipu-recall-hook.
if [ -n "${GROK_HOOK_NAME:-}${GROK_HOOK_EVENT:-}" ] || [ "${KHIPU_HARNESS:-}" = "aegis" ]; then
  cat >/dev/null 2>&1
  echo '{}'
  exit 0
fi
# Resolve the repo from THIS script's own location (following the shim symlink)
# rather than a hardcoded path — see khipu-recall-hook for why.
SELF="$0"
HOPS=0
while [ -L "$SELF" ] && [ "$HOPS" -lt 40 ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
  HOPS=$((HOPS + 1))
done
SELF_DIR=$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)
ROOT="${KHIPU_ROOT:-$(cd "$SELF_DIR/../../.." 2>/dev/null && pwd)}"
PYTHONPATH="$ROOT/packages/cli:$ROOT/.python_libs${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
# Bytecode cache goes OUTSIDE any signed .app bundle — see khipu.paths.pycache_dir.
PYTHONPYCACHEPREFIX="${HOME}/Library/Caches/Khipu/pycache"
mkdir -p "$PYTHONPYCACHEPREFIX" 2>/dev/null
export PYTHONPYCACHEPREFIX
PY="${KHIPU_PYTHON:-/opt/homebrew/bin/python3.11}"
[ -x "$PY" ] || PY="python3"
"$PY" -c "from khipu.routing_delegation import main; main()" 2>/dev/null || echo '{}'
exit 0
